// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model message {
  id String @id @default(uuid()) 
  content String?
  isImage Boolean?
  imageSrc String?
  username String
  dateCreated DateTime @default(now())
  user user @relation(fields: [username] , references: [username])
  groupID String 
  group chat @relation(fields: [groupID] , references: [id])
}

model chat {
  id String @id @default(uuid())
  name String?
  members user[]
  messages message[]
}

model user {
  username String @id
  password String
  name String
  lastOnline DateTime @default(now())
  isOnline Boolean @default(true)
  avatar String @default("")
  about String @default("")
  messages message[]
  chats chat[]
  sentRequests     friendShip[] @relation("SentRequests")
  receivedRequests friendShip[] @relation("ReceivedRequests")
}

enum requestStatus {
  PENDING
  ACCEPTED
}

model friendShip {
  senderUsername String
  receiverUsername String
  status requestStatus @default(PENDING)
  sender     user     @relation("SentRequests", fields: [senderUsername], references: [username])
  receiver   user     @relation("ReceivedRequests", fields: [receiverUsername], references: [username])
@@unique([senderUsername, receiverUsername]) 
}
